-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k privileged
-w /etc/sudoers.d/ -p wa -k privileged
-w /etc/ssh/sshd_config -p wa -k ssh
-w /etc/hosts -p wa -k hosts
-w /etc/fstab -p wa -k fstab
-w /etc/resolv.conf -p wa -k dns
-w /etc/systemd/resolved.conf -p wa -k resolved
-w /usr/bin/sudo -p x -k privileged
-w /usr/bin/sudoedit -p x -k privileged
-w /usr/bin/su -p x -k privileged
-w /usr/bin/passwd -p x -k privileged
-w /usr/bin/gpasswd -p x -k privileged
-w /usr/bin/chsh -p x -k privileged
-w /usr/bin/chfn -p x -k privileged
-w /usr/bin/setfacl -p x -k privileged
-w /usr/bin/chmod -p wa -k privileged
-w /usr/bin/chown -p wa -k privileged